# ekatva-link: the phone link, before and after login (apps/link).
# Runs as the `ekatva` user, never root: it parses everything that comes
# through the tunnel, so it gets nothing it doesn't need.
[Unit]
Description=ekatva-link: your phone's link to this laptop, before and after login
Documentation=https://theyashsawarkar.github.io/ekatva/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ekatva
Group=ekatva
ExecStart=/usr/local/lib/ekatva/ekatva-link
StateDirectory=ekatva
StateDirectoryMode=0700
RuntimeDirectory=ekatva
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
Restart=always
RestartSec=2

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
# AF_NETLINK: listing the network's addresses for the LAN beacon.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
