[Unit]
Description=ekatva: AI agents' MCP socket (pranali)
Documentation=https://ekatva.theyashsawarkar.dev/guides/ai-agents/

# Held by systemd, not the daemon: agents' connections wait in its backlog
# while ekatva.service restarts (an update) instead of failing, and a
# connection starts the service when it isn't running.
# Tied to the desktop session like ekatva.service: a connection before it
# would otherwise start the daemon without the session's display.
PartOf=graphical-session.target

[Socket]
ListenStream=%t/ekatva/mcp.sock
SocketMode=0600
DirectoryMode=0700
Service=ekatva.service

[Install]
WantedBy=graphical-session.target
