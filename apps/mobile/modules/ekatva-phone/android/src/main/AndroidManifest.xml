<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.CALL_PHONE" />
  <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
  <uses-permission android:name="android.permission.READ_PHONE_STATE" />
  <uses-permission android:name="android.permission.READ_CALL_LOG" />
  <uses-permission android:name="android.permission.READ_CONTACTS" />
  <uses-permission android:name="android.permission.READ_SMS" />
  <uses-permission android:name="android.permission.SEND_SMS" />
  <uses-permission android:name="android.permission.RECEIVE_SMS" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <!-- Calls and texts reach the laptop with the screen off: you allow it once (Settings, This phone). -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
  <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
  <!-- Hearing the laptop's beacon on the same network, also with the screen off. -->
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <!-- Find my phone: ring through Do Not Disturb (you allow it once), and vibrate. -->
  <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <!-- After a restart: "Tap to reconnect to your laptop" (only when one is paired). -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- Light and dark from the laptop: a system setting, granted once over USB
       (adb shell pm grant io.github.theyashsawarkar.ekatva android.permission.WRITE_SECURE_SETTINGS). -->
  <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" xmlns:tools="http://schemas.android.com/tools" tools:ignore="ProtectedPermissions" />

  <application>
    <!-- Locking the phone: you turn this on once, in the app's settings. -->
    <receiver
      android:name=".AdminReceiver"
      android:exported="true"
      android:label="ekatva: lock this phone from the laptop"
      android:permission="android.permission.BIND_DEVICE_ADMIN">
      <meta-data android:name="android.app.device_admin" android:resource="@xml/ekatva_device_admin" />
      <intent-filter>
        <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
      </intent-filter>
    </receiver>

    <!-- The phone's notifications, mirrored to the laptop (you allow it in Android's settings). -->
    <service
      android:name=".Notifications"
      android:exported="true"
      android:label="ekatva"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>

    <!-- Other Vayu apps on this phone (nāda, vāgdevī…) reach their laptop halves through
         ekatva. Exported with no permission on purpose: who an app is comes from Android
         (its uid, package and signing certificate), and nothing passes until you've
         allowed that exact app in ekatva (AppBridge.kt). -->
    <service
      android:name=".AppBridgeService"
      android:exported="true"
      tools:ignore="ExportedService"
      xmlns:tools="http://schemas.android.com/tools">
      <intent-filter>
        <action android:name="io.github.theyashsawarkar.ekatva.APPS" />
      </intent-filter>
    </service>

    <!-- Staying linked with the laptop while the app is in the background. -->
    <service
      android:name=".LinkService"
      android:exported="false"
      android:foregroundServiceType="connectedDevice" />
    <!-- The "Stop ringing" button on the find-my-phone notification. -->
    <receiver android:name=".RingStopReceiver" android:exported="false">
      <intent-filter>
        <action android:name="io.github.theyashsawarkar.ekatva.STOP_RINGING" />
      </intent-filter>
    </receiver>

    <!-- After a restart, when a laptop is paired: "Tap to reconnect" (BootReceiver.kt). -->
    <receiver android:name=".BootReceiver" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>

    <!-- A laptop notification swiped away on the phone. -->
    <receiver android:name=".LaptopNotificationReceiver" android:exported="false">
      <intent-filter>
        <action android:name="io.github.theyashsawarkar.ekatva.LAPTOP_NOTIFICATION_DISMISSED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
