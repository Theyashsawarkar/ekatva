{
  "expo": {
    "name": "ekatva",
    "slug": "ekatva",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ekatva",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#16121b",
    "android": {
      "package": "io.github.theyashsawarkar.ekatva",
      "adaptiveIcon": {
        "backgroundColor": "#16121b",
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "monochromeImage": "./assets/images/adaptive-monochrome.png"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.MANAGE_EXTERNAL_STORAGE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.CAMERA"
      ],
      "allowBackup": false,
      "intentFilters": [
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": [
            {
              "mimeType": "*/*"
            }
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "category": ["DEFAULT"],
          "data": [
            {
              "mimeType": "*/*"
            }
          ]
        }
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#16121b",
          "image": "./assets/images/splash.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "ekatva uses Face ID to open."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 29,
            "extraProguardRules": "-keep class io.github.theyashsawarkar.ekatva.** { *; }\n-keep class com.google.mlkit.** { *; }\n-keep class com.google.android.gms.internal.mlkit_** { *; }\n-keep class com.google.android.libraries.barhopper.** { *; }\n-keep class com.google.photos.vision.barhopper.** { *; }\n",
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "gifEnabled": false,
            "webpEnabled": false,
            "buildArchs": ["arm64-v8a"]
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Bricolage-600.ttf",
            "./assets/fonts/Bricolage-700.ttf",
            "./assets/fonts/JetBrainsMono-400.ttf",
            "./assets/fonts/JetBrainsMono-600.ttf",
            "./assets/fonts/Onest-400.ttf",
            "./assets/fonts/Onest-500.ttf",
            "./assets/fonts/Onest-600.ttf",
            "./assets/fonts/Onest-700.ttf",
            "./assets/fonts/Tiro-400.ttf"
          ]
        }
      ],
      "./plugins/with-english-only.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
